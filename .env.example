# =============================================================
# OPRIA — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# =============================================================

# ─── PUBLIC (safe to expose to browser) ────────────────────
# These are prefixed with NEXT_PUBLIC_ and used by client-side code.

# Supabase project URL (from Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (from Dashboard → Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Application URL (used for redirects, emails, and CORS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── SERVER-ONLY (NEVER expose to browser) ─────────────────
# These must NOT have NEXT_PUBLIC_ prefix.

# Supabase service-role key (from Dashboard → Settings → API → service_role secret)
# ⚠️ SECRET: This key bypasses Row Level Security. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── DATABASE ──────────────────────────────────────────────
# Prisma uses these to connect to Supabase PostgreSQL.

# Runtime connection — use Transaction Pooler (port 6543) for serverless (Vercel).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Get from: Dashboard → Settings → Database → Connection string → Select "Transaction" mode → Copy
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Migration connection — use Session Pooler (port 5432) or Direct for Prisma CLI.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Get from: Dashboard → Settings → Database → Connection string → Select "Session" mode → Copy
# Required for: npx prisma db push, npx prisma migrate dev
DIRECT_URL=postgresql://postgres:password@localhost:5432/postgres

# ─── SUPABASE (internal) ───────────────────────────────────
# No additional Supabase variables needed beyond the three above.

# ─── AI PROVIDER ───────────────────────────────────────────
# Configure which AI provider to use. All AI calls go through the provider abstraction.

# Provider: "gemini" | "openai" | "custom"
# Use "openai" with AI_BASE_URL=https://openrouter.ai/api/v1 for OpenRouter (free models work).
AI_PROVIDER=gemini

# API key for the selected provider.
# ⚠️ SECRET: Never expose to browser. All AI calls must be server-side.
# For Gemini: Get from https://aistudio.google.com/apikey
# For OpenAI: Get from https://platform.openai.com/api-keys
# For OpenRouter: Get from https://openrouter.ai/keys
AI_API_KEY=your-api-key-here

# Model name (must be valid for the selected provider)
# Gemini examples: gemini-3.6-flash, gemini-2.5-pro, gemini-3.5-flash
# OpenAI examples: gpt-4o, gpt-4o-mini, o1-mini
# Comma-separated fallback chains are supported (OpenAI-compatible providers):
# the next model is tried when the previous one is rate-limited or returns
# invalid output. Recommended for OpenRouter free tiers, whose upstream pools
# saturate independently.
AI_MODEL=gemini-3.6-flash

# Optional per-bucket model overrides (recommended for OpenRouter free tiers —
# separates the daily quota of the analysis pipeline from advisor conversations).
# Accepts the same comma-separated fallback chains as AI_MODEL.
#   AI_MODEL_JSON — structured agents: business analysis, research, matching,
#                   explanation, requirements, opportunities.
#                   Supports response_format. Free picks: google/gemma-4-31b-it:free,
#                   nvidia/nemotron-3-super-120b-a12b:free, apodex/apodex-1.1-mini:free
#   AI_MODEL_CHAT — advisor conversational agent. Same free picks apply.
# Both fall back to AI_MODEL when unset.
# AI_MODEL_JSON=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# AI_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Maximum tokens per AI response
AI_MAX_TOKENS=4096

# ─── OPTIONAL ──────────────────────────────────────────────

# Custom base URL for OpenAI-compatible providers (Groq, LiteLLM, OpenRouter, etc.)
# Leave commented out for Gemini or standard OpenAI.
# OpenRouter: https://openrouter.ai/api/v1
# AI_BASE_URL=https://api.openai.com/v1

# Enable demo mode with pre-seeded Bella's Boutique data
# Set to "true" for hackathon demonstrations
DEMO_MODE_ENABLED=false

# ─── APP (auto-detected, usually no changes needed) ────────
NODE_ENV=development
